rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    match /kayitlar/{id} {

      allow read:
        if request.auth != null;

      allow create:
        if true;

      allow update, delete:
        if request.auth != null;

    }

    match /loglar/{id} {

      allow read:
        if request.auth != null;

      allow write:
        if request.auth != null;

    }

  }

}